# ==========================================
# RAG Service Configuration
# ==========================================
# Copy this file to `.env` and fill in the values.
# DO NOT commit the actual `.env` file to Git.

# --- APPLICATION ---
APP_NAME="LMS RAG Service"
APP_ENV="production"
LOG_LEVEL="INFO"

# --- API ---
API_PREFIX="/v1"
HOST="0.0.0.0"
PORT=8000

# --- SUPABASE ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="lms-rag-documents"

# --- QDRANT ---
# Use the private LAN IP or Docker service name
QDRANT_URL="http://qdrant:6333"
QDRANT_API_KEY="replace-with-qdrant-api-key"
QDRANT_COLLECTION="lms_knowledge_base"

# --- REDIS ---
REDIS_URL="redis://redis:6379/0"

# --- CELERY ---
# Using different Redis DBs for broker and backend to avoid conflicts
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# --- EMBEDDING ---
EMBEDDING_MODEL="BAAI/bge-m3"
# Use "cuda" for the GPU server, "cpu" for local laptop testing
EMBEDDING_DEVICE="cuda"

# --- RERANKER ---
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
# Use "cuda" for the GPU server, "cpu" for local laptop testing
RERANKER_DEVICE="cuda"

# --- RETRIEVAL ---
# Hybrid retrieval pipeline stages
DEFAULT_TOP_K=50     # Initial candidates from Qdrant dense + sparse search
RERANK_TOP_K=10      # Candidates passed to the BGE reranker
FINAL_TOP_K=5        # Final context chunks returned to the LMS

# --- INGESTION ---
MAX_FILE_SIZE_MB=50
# Chunk size in tokens (BGE-M3 supports up to 8192, but 512-1024 is optimal for retrieval)
CHUNK_SIZE=1024
CHUNK_OVERLAP=100